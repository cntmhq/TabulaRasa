# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: Your Google OAuth 2.0 Client ID for Identity Services
VITE_GOOGLE_CLIENT_ID="your-google-client-id-here.apps.googleusercontent.com"

# VITE_GOMAILPROXY_URL: Base URL of the gomailproxy backend (test env up to 50 users).
# Leave unset to hide the "Send via Gmail" feature entirely.
VITE_GOMAILPROXY_URL="http://localhost:8080"
