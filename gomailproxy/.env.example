# GomailProxy environment configuration.
# Copy to .env and fill in values for local development.

# 32-byte hex-encoded root key for AES-256-GCM database encryption.
# Generate with: openssl rand -hex 32
GOMAPROXY_ENCRYPTION_KEY=

# Google OAuth2 client credentials (test Google Cloud project).
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Public OAuth2 redirect URI registered with Google. Must match exactly.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/oauth/callback

# Frontend URL the user is redirected back to after the consent flow completes.
APP_URL=http://localhost:3000

# Comma-separated list of origins permitted to call the proxy.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Sqlite database file path. Production: swap for Postgres DSN via DATABASE_URL.
DATABASE_PATH=./gomailproxy.db

# Bind address for the HTTP listener.
LISTEN_ADDR=:8080

# Hard cap on authorized accounts during the test phase.
MAX_ACCOUNTS=50
